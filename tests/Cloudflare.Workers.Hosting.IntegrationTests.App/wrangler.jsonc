{
    // Worker under test for tests/Cloudflare.Workers.Hosting.IntegrationTests.
    //   dotnet publish -c Release
    //   npm ci
    //   wrangler dev -c wrangler.jsonc -c upstream/wrangler.jsonc --test-scheduled
    "name": "e2e-worker-csharp",
    "main": "bin/Release/net10.0/wasi-wasm/publish/worker/index.js",
    "compatibility_date": "2026-07-01",
    "vars": {
        "E2E_VAR": "value from wrangler.jsonc"
    },
    "kv_namespaces": [
        { "binding": "E2E_KV" }
    ],
    "r2_buckets": [
        { "binding": "E2E_R2", "bucket_name": "e2e-bucket" }
    ],
    "d1_databases": [
        { "binding": "E2E_DB", "database_name": "e2e-db", "database_id": "e2e-db-local" }
    ],
    "services": [
        { "binding": "E2E_UPSTREAM", "service": "e2e-upstream" }
    ],
    "triggers": {
        "crons": ["*/5 * * * *"]
    }
}
