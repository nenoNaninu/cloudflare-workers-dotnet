{
    // Worker under test for tests/Cloudflare.Workers.Hosting.IntegrationTests.
    //   dotnet publish -c Release
    //   npm ci
    //   npm run dev
    "name": "integration-test-worker-csharp",
    "main": "bin/Release/net10.0/wasi-wasm/publish/worker/index.js",
    "compatibility_date": "2026-07-01",
    "vars": {
        "INTEGRATION_TEST_VAR": "value from wrangler.jsonc"
    },
    "kv_namespaces": [
        { "binding": "INTEGRATION_TEST_KV" }
    ],
    "r2_buckets": [
        { "binding": "INTEGRATION_TEST_R2", "bucket_name": "integration-test-bucket" }
    ],
    "d1_databases": [
        { "binding": "INTEGRATION_TEST_DB", "database_name": "integration-test-db", "database_id": "integration-test-db-local" }
    ],
    "services": [
        { "binding": "INTEGRATION_TEST_UPSTREAM", "service": "integration-test-upstream" }
    ],
    "triggers": {
        "crons": ["*/5 * * * *"]
    }
}
