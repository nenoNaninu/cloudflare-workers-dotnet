{
  // Local E2E variant of wrangler.jsonc: no remote KV binding, so `wrangler dev`
  // works without CLOUDFLARE_API_TOKEN (uses local simulated KV storage).
  "name": "hello-worker-csharp",
  "main": "bin/Release/net10.0/wasi-wasm/publish/worker/index.mjs",
  "compatibility_date": "2026-07-01",
  "build": {
    "command": "dotnet publish -c Release"
  },
  "vars": {
    "SAMPLE_VAR": "Hello from wrangler.local.jsonc"
  },
  "secrets": {
    "required": [
      "SAMPLE_SECRET"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "HELLO_KV"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hello-worker-db",
      "migrations_dir": "migrations"
    }
  ]
}
